APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8090
APP_NAME="Sistem Pengurusan Main Kutu"
APP_LOCALE=ms
APP_TIMEZONE=Asia/Kuala_Lumpur

DB_HOST=db
DB_PORT=3306
DB_DATABASE=mainkutu
DB_USERNAME=mainkutu
DB_PASSWORD=mainkutu_password
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_NAME=mainkutu_session
SESSION_SECURE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=Strict
SESSION_LIFETIME=120

MAX_UPLOAD_SIZE_MB=5
UPLOAD_PAYMENT_SLIPS_DIR=storage/uploads/payment-slips
UPLOAD_PAYOUT_SLIPS_DIR=storage/uploads/payout-slips

LOG_FILE=storage/logs/app.log
LOG_LEVEL=debug

CURRENCY=MYR
CURRENCY_SYMBOL=RM

AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_SECONDS=900
PASSWORD_RESET_TTL=3600
PASSWORD_MIN_LENGTH=8
