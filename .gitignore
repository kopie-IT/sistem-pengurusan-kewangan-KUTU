# Environment & secrets
.env
.env.local
.env.*.local
public_html/.env

# Dependencies
/vendor/
node_modules/

# Logs & runtime
public_html/storage/logs/*
!public_html/storage/logs/.gitkeep
public_html/storage/uploads/*
!public_html/storage/uploads/.gitkeep
*.log

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# Docker volumes / build artifacts
*.sqlite

# Local documentation / planning artifacts (not part of the runtime app)
/docs/
public_html/INSTALL.md

# Installer & sensitive runtime files
public_html/install.php
public_html/install-cli.php
public_html/storage/installed.lock

# Local env files copied into web root for cPanel first-deploy
public_html/.htaccess.bak
