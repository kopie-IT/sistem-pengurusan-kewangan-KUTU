APP_ENV=production
APP_DEBUG=false
APP_URL=https://example.com
APP_NAME="Sistem Pengurusan Main Kutu"
APP_LOCALE=ms
APP_TIMEZONE=Asia/Kuala_Lumpur

DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=kutu_main
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_NAME=mainkutu_session
SESSION_SECURE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=Strict
SESSION_LIFETIME=120

# File upload
MAX_UPLOAD_SIZE_MB=5
UPLOAD_PAYMENT_SLIPS_DIR=storage/uploads/payment-slips
UPLOAD_PAYOUT_SLIPS_DIR=storage/uploads/payout-slips

# Logging
LOG_FILE=storage/logs/app.log
LOG_LEVEL=error

# Currency
CURRENCY=MYR
CURRENCY_SYMBOL=RM

# Authentication
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_SECONDS=900
PASSWORD_RESET_TTL=3600
PASSWORD_MIN_LENGTH=8

# Docker development override (copy to .env for local Docker testing)
# APP_ENV=local
# APP_DEBUG=true
# APP_URL=http://localhost:8090
# DB_HOST=db
# DB_DATABASE=mainkutu
# DB_USERNAME=mainkutu
# DB_PASSWORD=mainkutu_password
